{
  "name": "dsh-file-extra",
  "version": "1.1.0",
  "description": "DeepSeek Harness (dsh) plugin: file-tree actions (upload, download, delete) plus inline selection comments in the document preview.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/wrap-client.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "file-upload",
    "file-download",
    "file-delete",
    "file-comment",
    "file-tree"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-client-file-upload": "^0.1.3-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
